        string resourcePath = string `/token`;
        // See the `post token` function above for why this is not a {...headers} spread.
        map<anydata> headerValues = {};
        if headers.pricefxKey is string {
            headerValues["Pricefx-Key"] = headers.pricefxKey;
        }
        if self.apiKeyConfig is ApiKeysConfig {
            headerValues["X-PriceFx-jwt"] = self.apiKeyConfig?.xPriceFxJwt;
        }
        map<string|string[]> httpHeaders = http:getHeaderMap(headerValues);
        return self.clientEp->delete(resourcePath, headers = httpHeaders);
    }

