# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# macOS Files
*.DS_Store

# Ignore everything in this directory
target
.classpath
.settings
.project
*.iml
*.iws
*.ipr
.m2
.vscode/
.cursor/
.idea

# Ignore ballerina files
target/
generated/
.ballerina
**/Config.toml

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore Docker env file
docker.env

# Ignore the Ballerina installer the CI "Set Up Ballerina" step downloads into the workspace.
# The release plugin's checkCommitNeeded task aborts on any untracked file, so leaving this
# unignored fails the publish job even though nothing is wrong with the build.
ballerina-*-swan-lake-*.deb
ballerina-*-swan-lake-*.pkg
ballerina-*-swan-lake-*.msi
